# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL — use the "Pooled connection" string from neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
# Admin login credentials for the UI
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password

# Secret used for JWT signing + AES-256-GCM token encryption (min 32 chars)
GATEWAY_SECRET=change-me-to-a-long-random-secret-32+chars

# ── Email Alerts ────────────────────────────────────────────────────────────────
# Resend API key (https://resend.com — free tier: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in Resend
ALERT_FROM_EMAIL=gateway@yourcompany.com
# Who receives the alert emails
ALERT_TO_EMAIL=admin@yourcompany.com

# ── Claude Subprocess ──────────────────────────────────────────────────────────
# Path to the Claude CLI binary on the server
# macOS dev: /Users/you/Library/Application Support/Claude/claude-code/VERSION/claude.app/Contents/MacOS/claude
# Linux VM:  /usr/local/bin/claude
CLAUDE_BINARY=/usr/local/bin/claude
# Base directory for per-account isolated HOME dirs (must be writable)
CLAUDE_HOMES_DIR=/var/gateway/accounts
# Default Claude model
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6

# ── OpenAI OAuth ───────────────────────────────────────────────────────────────
# During dev: http://localhost:5173/oauth/callback
# In prod:    https://your-gateway-domain/oauth/callback
OPENAI_REDIRECT_URI=http://localhost:1455/auth/callback

# ── Gemini OAuth ───────────────────────────────────────────────────────────────
# Uses Gemini CLI's Google OAuth app credentials (loopback redirect — no script needed)
GEMINI_CLIENT_ID=681255809395-oo8ft2oprdrnp9e3aqf6av3hmdib135j.apps.googleusercontent.com
GEMINI_CLIENT_SECRET=your-gemini-client-secret

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
